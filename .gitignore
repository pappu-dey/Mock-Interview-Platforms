# ============================================================
#  ROOT .gitignore — Mock Interview Platform
# ============================================================

# ─── Environment & Secret Files ─────────────────────────────
.env
.env.*
!.env.example
*.env

# ─── Spring Boot Sensitive Config ───────────────────────────
**/application-local.properties
**/application-local.yml
**/application-secret.properties
**/application-secret.yml

# Keep the template, ignore the real one
**/application.properties
!**/application.properties.example

# ─── OS Files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / Editor ───────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Java / Maven ───────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ─── Node / Frontend ────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
