# Shared local configuration for the frontend and Spring backend.
# Copy this file to .env and replace every placeholder with a real value.

VITE_API_BASE_URL=https://main-mock-interview-platforms-pappus-workspace.light-cloud.io
VITE_APP_NAME=MockInterview
VITE_GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/<DB_NAME>?ssl-mode=REQUIRED
SPRING_DATASOURCE_USERNAME=<YOUR_DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<YOUR_DB_PASSWORD>
JWT_SECRET=<YOUR_JWT_SECRET_HEX>
CLOUDINARY_URL=cloudinary://<YOUR_API_KEY>:<YOUR_API_SECRET>@<YOUR_CLOUD_NAME>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
